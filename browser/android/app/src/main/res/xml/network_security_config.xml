<?xml version="1.0" encoding="utf-8"?>
<!-- A browser must load http:// pages; the app itself only talks https (lists, update check). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
