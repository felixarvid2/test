#!/bin/sh
set -e

if [ "$1" = "remove" ] && [ -d /run/systemd/system ]; then
    deb-systemd-invoke --user stop 'fartvakt.service' >/dev/null 2>&1 || true
fi
if command -v py3clean >/dev/null 2>&1; then
    py3clean -p fartvakt
else
    find /usr/lib/python3/dist-packages/fartvakt -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null || true
fi
exit 0
