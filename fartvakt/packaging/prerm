#!/bin/sh
set -e

if [ "$1" = "remove" ]; then
    for dir in /run/user/*; do
        [ -d "$dir" ] || continue
        uid=$(basename "$dir")
        [ "$uid" -ge 1000 ] 2>/dev/null || continue
        user=$(getent passwd "$uid" | cut -d: -f1)
        [ -n "$user" ] || continue
        runuser -u "$user" -- env XDG_RUNTIME_DIR="$dir" DBUS_SESSION_BUS_ADDRESS="unix:path=$dir/bus" \
            systemctl --user stop fartvakt.service >/dev/null 2>&1 || true
    done
    systemctl --global disable fartvakt.service >/dev/null 2>&1 || true
fi
exit 0
