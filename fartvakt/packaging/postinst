#!/bin/sh
set -e

# Version 1.0 låg i /usr/lib/fartvakt; ta bort bytekod som dpkg inte känner till.
if [ "$1" = "configure" ] && [ -n "$2" ] && dpkg --compare-versions "$2" lt 1.1.0 && [ -d /usr/lib/fartvakt ]; then
    find /usr/lib/fartvakt -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null || true
    find /usr/lib/fartvakt -depth -type d -empty -delete 2>/dev/null || true
fi

if [ "$1" = "configure" ] && command -v py3compile >/dev/null 2>&1; then
    py3compile -p fartvakt
fi

if [ "$1" = "configure" ] || [ "$1" = "abort-upgrade" ] || [ "$1" = "abort-deconfigure" ] || [ "$1" = "abort-remove" ]; then
    # Aktivera bevakningen vid inloggning för alla användare (samma som dh_installsystemduser).
    deb-systemd-helper --user unmask 'fartvakt.service' >/dev/null || true
    if deb-systemd-helper --quiet --user was-enabled 'fartvakt.service'; then
        deb-systemd-helper --user enable 'fartvakt.service' >/dev/null || true
    else
        deb-systemd-helper --user update-state 'fartvakt.service' >/dev/null || true
    fi
    # Starta (eller starta om efter uppgradering) direkt för den som redan är inloggad.
    if [ -d /run/systemd/system ]; then
        deb-systemd-invoke --user daemon-reload >/dev/null 2>&1 || true
        deb-systemd-invoke --user restart 'fartvakt.service' >/dev/null 2>&1 || true
    fi
fi

exit 0
